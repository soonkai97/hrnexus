# Copy this file to .env and fill in your values before running docker compose up
DOMAIN=yourdomain.com
JWT_SECRET=replace-this-with-a-long-random-string-at-least-32-chars

# Web Push (VAPID) — required for browser push notifications
# Generate a fresh pair with: npx web-push generate-vapid-keys
VAPID_SUBJECT=mailto:admin@yourdomain.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
