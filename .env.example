# Copy this file to .env and fill in your values before running docker compose
# cp .env.example .env

# ── Domain ───────────────────────────────────────────────────────────────────
# Your DuckDNS hostname (no https://, no trailing slash)
DOMAIN=yourname.duckdns.org

# Same value — used by docker-compose.uat.yml to set CORS allowed origins
UAT_HOST=yourname.duckdns.org

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_DB=nightclub_workforce
POSTGRES_USER=ncuser
# Change this — the default is weak
POSTGRES_PASSWORD=change-this-to-a-strong-password

# ── API secrets ──────────────────────────────────────────────────────────────
# JWT signing key — minimum 32 characters
JWT_SECRET=replace-this-with-a-long-random-string-at-least-32-chars

# Feature-flags unlock PIN (bcrypt hash).
# Default hash is PIN "0000". To change:
#   htpasswd -bnBC 12 "" YOUR_PIN | tr -d ':\n' | sed 's/$2y/$2a/'
# Then paste the result (replace $ with $$) as FEATURE_PIN_HASH.
# Leave blank to keep the default "0000" PIN (not recommended for production).
FEATURE_PIN_HASH=
# Random secret used to sign the feature-unlock session token. Any long random string.
FEATURE_TOKEN_SECRET=

# ── Web Push (VAPID) — browser push notifications ────────────────────────────
# Leave PublicKey + PrivateKey empty to disable push notifications
# Generate a fresh pair with: npx web-push generate-vapid-keys
VAPID_SUBJECT=mailto:admin@yourdomain.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
