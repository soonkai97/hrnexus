# Normalize line endings to LF on commit, check out as-is
* text=auto eol=lf

# Windows batch files need CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binaries
*.png  binary
*.jpg  binary
*.jpeg binary
*.ico  binary
*.gif  binary
*.pdf  binary
*.dll  binary
*.exe  binary

# Git hooks and shell scripts must keep LF line endings (they run under sh/bash).
.githooks/* text eol=lf
*.sh text eol=lf
*.mjs text eol=lf
