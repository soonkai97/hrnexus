root = true

[*.cs]
indent_style = space
indent_size = 4

# ── Style parity with the IMS standard (github.com/soonkai97/IMS) ────────────────────────────────────
# `suggestion` on purpose: they show in the IDE but never fail the build (CI builds with -warnaserror). Raise a
# rule to `warning` only after the existing code base passes it (about 22 files still use block-scoped namespaces).
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_using_directive_placement = outside_namespace:suggestion
dotnet_sort_system_directives_first = true
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_prefer_braces = when_multiline:suggestion
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
# Private fields: _camelCase
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_rule.private_fields_underscore.severity = suggestion
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case
# Interfaces start with I
dotnet_naming_rule.interfaces_start_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_start_with_i.style = begins_with_i
dotnet_naming_rule.interfaces_start_with_i.severity = suggestion
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.begins_with_i.required_prefix = I
dotnet_naming_style.begins_with_i.capitalization = pascal_case

# Fail the build on unused using directives (the C# analog of FE's noUnusedLocals for imports).
dotnet_diagnostic.IDE0005.severity = error

# ── .NET analyzer (CA) tuning ──────────────────────────────────────────────────
# latest-recommended is enabled in Directory.Build.props; these rules are silenced because they
# fight this codebase's deliberate conventions or are over-engineering for its scale. Everything
# else stays at its default (warning) severity so genuinely useful findings remain visible.
dotnet_diagnostic.CA1707.severity = none        # underscores in identifiers — xUnit test-name convention
dotnet_diagnostic.CA1725.severity = none        # param name must match interface — we use 'ct' consistently
dotnet_diagnostic.CA1848.severity = none        # LoggerMessage delegates — over-engineering for this app's log volume
dotnet_diagnostic.CA1861.severity = none        # prefer static readonly arrays over constant args — micro-optimisation
# Culture-sensitivity nudges: keep visible in the IDE but not as build noise.
dotnet_diagnostic.CA1304.severity = suggestion
dotnet_diagnostic.CA1305.severity = suggestion
dotnet_diagnostic.CA1310.severity = suggestion
dotnet_diagnostic.CA1311.severity = suggestion
# EF Core LINQ predicates use .ToLower()/.ToUpperInvariant(), which translate to SQL LOWER()/UPPER().
# CA1862's suggested string.Equals(StringComparison) overload is NOT translatable by EF (Npgsql throws
# "could not be translated" at runtime), so this rule is a false positive across the query layer.
dotnet_diagnostic.CA1862.severity = none
# CA1873 flags logging arguments as "potentially expensive"; ours are cheap property/field accesses on
# always-on Information logs, so the IsEnabled guard it wants adds noise without benefit.
dotnet_diagnostic.CA1873.severity = none
# CA1711 reserves the 'Permission' suffix for System.Security.IPermission types. Our RolePermission is a
# domain join entity (role -> permission key), not a code-access-security permission — a false positive.
dotnet_diagnostic.CA1711.severity = none

# Generated EF Core migrations are scaffolded — don't enforce style on them.
[**/Migrations/*.cs]
dotnet_diagnostic.IDE0005.severity = none

# Test conventions that fight CA defaults.
[tests/**/*.cs]
dotnet_diagnostic.CA1001.severity = none   # disposable test fields are released via xUnit IAsyncLifetime.DisposeAsync
