{
  "name": "hrnexus",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve web",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "lint": "eslint .",
    "test": "ng test shared-lib",
    "test:shared": "ng test shared-lib",
    "test:web": "ng test web",
    "test:all": "ng test shared-lib && ng test web",
    "test:coverage": "ng test shared-lib --coverage",
    "test:watch": "npx vitest --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "hooks:install": "node scripts/setup-git-hooks.mjs",
    "guard:test": "node --test scripts/guard/lib.test.mjs scripts/format-check.test.mjs scripts/payroll-worked-examples.test.mjs",
    "format:check": "node scripts/format-check.mjs"
  },
  "private": true,
  "packageManager": "npm@11.13.0",
  "dependencies": {
    "@angular/common": "^21.2.26",
    "@angular/compiler": "^21.2.26",
    "@angular/core": "^21.2.26",
    "@angular/forms": "^21.2.26",
    "@angular/platform-browser": "^21.2.26",
    "@angular/router": "^21.2.26",
    "@angular/service-worker": "^21.2.26",
    "@microsoft/signalr": "^10.0.11",
    "@primeuix/themes": "^2.0.3",
    "bootstrap": "^5.3.9",
    "primeicons": "^7.0.0",
    "primeng": "^21.1.7",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.30",
    "@angular/cli": "^21.2.30",
    "@angular/compiler-cli": "^21.2.26",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@vitest/coverage-v8": "^4.1.12",
    "angular-eslint": "21.4.0",
    "eslint": "^10.14.0",
    "jsdom": "^28.0.0",
    "ng-packagr": "^21.2.7",
    "prettier": "^3.10.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.72.2",
    "vitest": "^4.1.12"
  }
}
