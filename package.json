{
  "name": "nightclub-workforce",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start:admin": "ng serve admin-app",
    "start:staff": "ng serve staff-app",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test shared-lib",
    "test:shared": "ng test shared-lib",
    "test:admin": "ng test admin-app",
    "test:staff": "ng test staff-app",
    "test:all": "ng test shared-lib && ng test admin-app && ng test staff-app",
    "test:coverage": "ng test shared-lib --coverage",
    "test:watch": "npx vitest --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:admin": "playwright test --project=admin",
    "test:e2e:staff": "playwright test --project=staff"
  },
  "private": true,
  "packageManager": "npm@11.13.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/service-worker": "^21.2.0",
    "@microsoft/signalr": "^10.0.0",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "@primeuix/themes": "^2.0.3",
    "bootstrap": "^5.3.8",
    "primeicons": "^7.0.0",
    "primeng": "^21.1.7",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.9",
    "@angular/cli": "^21.2.9",
    "@angular/compiler-cli": "^21.2.0",
    "@playwright/test": "^1.60.0",
    "@vitest/coverage-v8": "^4.1.6",
    "jsdom": "^28.0.0",
    "ng-packagr": "^21.2.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
